----------------------------------------
Standard Python/Flask Ignore List
----------------------------------------

# Byte-compiled / optimized / dynamically generated files
__pycache__/
*.pyc
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/
.dmypy.json

# Environment
# Ignore the virtual environment folder entirely
/venv/
/env/

# Specific file created by venv and pipenv
pip-log.txt
pip-selfcheck.json
.python-version

# IDE and Editor Files
.vscode/
*.sublime-workspace
.atom/

----------------------------------------
Project-Specific Ignore List
----------------------------------------

# Database Files
# It's best practice to ignore the local dev database
/leave.db

# Sensitive/Local Config Files (CRUCIAL)
# --- THIS IS THE MOST IMPORTANT PART ---
# Never commit your secrets (passwords, API keys)
.env
*.env
instance/

# Log files
*.log
tmp/