pipeline {
    // This pipeline is designed to run on a Windows agent
    agent any 

    environment {
        BUILD_RECIPIENTS = 'Yogitaagrawal27@outlook.com'
        
        // Corrected Docker Hub username (from your info)
        DOCKER_HUB_USERNAME = 'yogitaagarwal20076'
        IMAGE_NAME = "${DOCKER_HUB_USERNAME}/elmp-app"
    }

    stages {
        
        // Stage 1: Checkout Source Code
        // This stage is now included. Jenkins will use the Git
        // repository you configured in the "Pipeline script from SCM" section.
        stage('Checkout Source Code') {
            steps {
                // This command pulls the code from the Git repo
                // configured in your Jenkins job.
                checkout scm
            }
        }

        // Stage 2: Run Unit Tests
        // This runs directly on the Jenkins agent (not in Docker)
        // to avoid the 'docker daemon' errors we saw earlier.
        stage('Run Unit Tests') {
            steps {
                echo 'Installing dependencies for testing...'
                // Use 'bat' for Windows commands
                // We use python -m pip to ensure the correct pip is called
                bat 'python -m pip install -r requirements.txt'
                
                echo 'Running unit tests...'
                // Runs pytest and creates an XML report
                bat 'python -m pytest --junitxml=test-reports.xml'
            }
            post {
                // This block runs after the steps, even if they fail
                always {
                    // This publishes the test results to the Jenkins dashboard
                    junit 'test-reports.xml'
                }
            }
        }

        // Stage 3: Build Docker Image
        stage('Build Docker Image') {
            steps {
                echo "Building Docker image: ${IMAGE_NAME}:${BUILD_NUMBER}"
                // Make sure Docker Desktop is running on your machine!
                bat "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} ."
                bat "docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest"
            }
        }

        // Stage 4: Push Docker Image
        stage('Push Docker Image') {
            steps {
                echo "Pushing Docker image to Docker Hub..."
                
                // Corrected credentialsId to 'dockerhub-creds'
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    // Log in to Docker Hub
                    bat "docker login -u ${DOCKER_USER} -p ${DOCKER_PASS}"
                    
                    // Push the new image
                    bat "docker push ${IMAGE_NAME}:${BUILD_NUMBER}"
                    bat "docker push ${IMAGE_NAME}:latest"
                    
                    // Log out
                    bat "docker logout"
                }
            }
        }
    }

    post {
        // This section runs at the end of the entire pipeline
        always {
            echo 'Build finished.'
        }
        success {
            echo 'Build Successful - Sending Notification Email.'
            emailext (
                subject: "SUCCESS: Jenkins Build #${BUILD_NUMBER} for ${IMAGE_NAME}",
                body: "The build for ${IMAGE_NAME} was successful. Image pushed to Docker Hub. View details: ${env.BUILD_URL}",
                to: BUILD_RECIPIENTS,
                attachLog: true
            )
        }
        failure {
            echo 'Build Failed - Sending Notification Email.'
            emailext (
                subject: "FAILURE: Jenkins Build #${BUILD_NUMBER} for ${IMAGE_NAME}",
                body: "The build for ${IMAGE_NAME} FAILED. Review the console output immediately: ${env.BUILD_URL}",
                to: BUILD_RECIPIENTS,
                attachLog: true
            )
        }
    }
}

